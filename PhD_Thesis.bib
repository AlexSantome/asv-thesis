@article{gomez-hidalgoFundamentalBuildingBlocks2026,
  title = {Fundamental {{Building Blocks}} for {{Scalable Photonic Programmable Processors}}},
  author = {Gómez‐Hidalgo, Cristina and Fernández‐Vicente, Juan and Balbastre‐Benavent, Natalia and Manglano‐Bermejo, María and Papadovasilakis, Marios and Elsharabasy, Ahmed and Baños‐López, Rocío and Benítez‐González, Jesús and Gutiérrez‐Campo, Ana and Hoekstra, Tsjerk and Pérez‐López, Daniel and Torrijos‐Morán, Luis},
